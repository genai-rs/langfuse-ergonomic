{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>genai-rs/.github:renovate-default'],
  // The shared preset enables cargo and github-actions; docker-compose keeps the pinned
  // images of the live-test stack (docker/langfuse/compose.yml) current.
  enabledManagers: ['cargo', 'github-actions', 'docker-compose'],
  packageRules: [
    {
      description: 'Keep UUID updates within the Rust 1.88 compatible range',
      matchManagers: ['cargo'],
      matchPackageNames: ['uuid'],
      allowedVersions: '<1.27.0',
      rangeStrategy: 'in-range-only',
    },
    {
      description: 'Core dependencies',
      matchPackageNames: ['serde', 'reqwest', 'tokio', 'bon', 'langfuse-client-base'],
      labels: ['dependencies', 'core'],
      automerge: true,
    },
    {
      description: 'Langfuse base client',
      matchPackageNames: ['langfuse-client-base'],
      labels: ['dependencies', 'langfuse-base'],
      automerge: true,
    },
    {
      description: 'Update the Langfuse web and worker images of the live-test stack together',
      matchManagers: ['docker-compose'],
      matchPackageNames: ['docker.io/langfuse/langfuse', 'docker.io/langfuse/langfuse-worker'],
      groupName: 'langfuse live-test images',
    },
  ],
}
